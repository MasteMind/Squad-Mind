# /srv/squad/secrets/.env — server secrets template for Squad-Mind.
# Copy to /srv/squad/secrets/.env and fill in. NEVER commit the filled file.
# Owner/perms: root:hermes 640 (deploy/server-install.sh enforces this;
# systemd units consume it via EnvironmentFile=/srv/squad/secrets/.env).
#
# ==================================================================
# LICENSING: Claude Max / ChatGPT Codex / Gemini Advanced are PER-HUMAN
# consumer subscriptions. Pointing a shared team server at personal
# OAuth/CLI tokens violates ToS, creates bus-factor-1 auth, and makes
# spend un-attributable. Use API keys billed to a team project —
# Vertex AI recommended on GCP (org billing + IAM); direct
# Anthropic/OpenAI/Gemini API keys also fine.
# ==================================================================

# ------------------------------------------------------------------
# LLM provider keys — exact var names hermes-agent reads:
#   ANTHROPIC_API_KEY (agent/anthropic_adapter.py:1139)
#   GOOGLE_API_KEY or GEMINI_API_KEY (agent/gemini_native_adapter.py:840)
#   OPENAI_API_KEY (agent/auxiliary_client.py:1823)
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...
GOOGLE_API_KEY=AIza...
OPENAI_API_KEY=sk-...

# Optional: Ollama endpoint for the junior agent (hermes_cli/models.py:3383).
#OLLAMA_BASE_URL=http://127.0.0.1:11434

# ------------------------------------------------------------------
# Slack — tokens from the app created via deploy/slack/app-manifest.yml.
#   SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...)
#   SLACK_APP_TOKEN: App-Level Token with connections:write (xapp-...)
# ------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack user IDs (U...) allowed to talk to the squad
# (gateway/platforms/slack.py:2869).
SLACK_ALLOWED_USERS=U0000000001,U0000000002

# Users allowed to dispatch work to the squad. NOTE: the dispatch-gating
# hook ships separately; until then this policy is enforced at the
# orchestrator-instruction layer, not in code.
SLACK_DISPATCH_USERS=U0000000001

# ------------------------------------------------------------------
# Ops timers (deploy/systemd/*.timer) — both optional
# ------------------------------------------------------------------
# Slack Incoming Webhook for vault-autocommit conflict/push alerts.
# Unset => alerts go to the journal only.
#SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/T000/B000/XXXX

# GCS bucket for nightly squad-backup uploads (name or gs:// URL).
# Unset => local-only backups in /srv/squad/archive/backups/.
#BACKUP_GCS_BUCKET=my-team-squad-backups

# ------------------------------------------------------------------
# Paths
# ------------------------------------------------------------------
VAULT_PATH=/srv/squad/brain
# HERMES_HOME is set per-profile by hermes-gateway@.service
# (Environment=HERMES_HOME=/srv/squad/hermes/profiles/%i) and systemd's
# EnvironmentFile= OVERRIDES Environment= — leave this commented unless
# running hermes outside systemd. Root home: /srv/squad/hermes.
#HERMES_HOME=/srv/squad/hermes
