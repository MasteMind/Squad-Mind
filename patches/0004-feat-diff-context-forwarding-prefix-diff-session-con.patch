+/**
+ * Stable fingerprint of a single OpenAI message. Used by SessionManager to
+ * detect which prefix of the incoming history has already been forwarded to
+ * the CLI in a prior turn, so it can ship only the new tail.
+ */
+export function hashMessage(msg: OpenAIMessage): string {
+  const norm = JSON.stringify({
+    role: msg.role,
+    content: msg.content ?? '',
+    name: msg.name ?? null,
+    tool_call_id: msg.tool_call_id ?? null,
+    tool_calls: msg.tool_calls ?? null,
+  });
+  return createHash('sha1').update(norm).digest('hex');
+}
+
