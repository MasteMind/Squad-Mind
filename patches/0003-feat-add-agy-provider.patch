@@ -62,4 +62,24 @@ export interface ProviderConfig {
    * Returns null if the event doesn't contain a session ID.
    */
   extractSessionId?(event: NdjsonEvent): string | null;
+
+  /**
+   * Whether the CLI emits NDJSON events on stdout.
+   *
+   * Defaults to `true` (existing providers: claude/gemini/codex).
+   * Set to `false` for CLIs that only print final plain text in their
+   * single-prompt mode (e.g. Antigravity CLI's `agy --print`). For these,
+   * session-manager bypasses the line-by-line JSON parser, accumulates
+   * full stdout, and synthesizes one text_delta + result event on exit.
+   */
+  emitsJson?: boolean;
+
+  /**
+   * Optional alternative to `extractSessionId` for providers that DO NOT
+   * emit their session/conversation ID on stdout, but write it to a
+   * known file on disk during the run (e.g. AGY's
+   * `~/.gemini/antigravity-cli/cache/last_conversations.json`).
+   * Called after the child process exits with code 0 in per-request mode.
+   */
+  extractSessionIdFromExit?(workspaceDir: string): string | null;
 }
