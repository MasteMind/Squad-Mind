+++ b/src/providers/agy.ts
@@ -0,0 +1,77 @@
+import { readFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { join } from 'node:path';
+import type { NdjsonEvent, NormalizedEventType } from '../types.js';
+import type { ProviderConfig } from './base.js';
+
+/**
+ * Antigravity CLI provider configuration.
+ *
+ * AGY (`agy`) is Google's Antigravity coding assistant CLI. Unlike the
+ * other providers in this proxy:
+ *
+ *   - It emits plain text on stdout in --print mode, NOT NDJSON. The
+ *     session-manager's emitsJson:false branch handles synthesis of
+ *     init/text/result events from accumulated stdout.
+ *   - It has no --model flag. Model selection lives in
+ *     ~/.gemini/antigravity-cli/settings.json (key: "model"), as a label
+ *     like "Gemini 3.5 Flash (Low)". The launcher writes this once at
+ *     proxy startup; the AGY process picks it up via that file.
+ *   - Conversation IDs are NOT echoed on stdout. AGY tracks them in
+ *     ~/.gemini/antigravity-cli/cache/last_conversations.json indexed by
+ *     workspace path. extractSessionIdFromExit reads this after each run
+ *     so the next request can pass --conversation <id>.
+ *   - AGY reads the prompt from stdin when launched as `agy --print`
+ *     with no positional argument. Stdin-pipe mode avoids the shell
+ *     quoting hazard that hits providers using `--prompt <content>` via
+ *     argv when the session-manager spawns with shell:true.
+ */
+export const agyProvider: ProviderConfig = {
+  binary: 'agy',
+  displayName: 'Antigravity CLI',
+  defaultModel: 'Gemini 3.5 Flash (Low)',
+  models: [
+    'Gemini 3.5 Flash (Low)',
+    'Gemini 3.5 Flash (High)',
+    'Gemini 3.5 Pro (Low)',
+    'Gemini 3.5 Pro (High)',
+  ],
+  mode: 'per-request',
+  emitsInit: false,
+  usesStdinPipe: true,
+  emitsJson: false,
+
+  buildSpawnArgs(resumeSessionId: string): string[] {
+    const args = ['--print', '--dangerously-skip-permissions'];
+    if (resumeSessionId) {
+      args.push('--conversation', resumeSessionId);
+    }
+    return args;
+  },
+
+  buildStdinMessage(content: string): string {
+    return content;
+  },
+
+  normalizeEventType(rawType: string): NormalizedEventType {
+    if (rawType === 'text') return 'text_delta';
+    if (rawType === 'result') return 'result';
+    if (rawType === 'error') return 'error';
+    return 'unknown';
+  },
+
+  extractTextContent(event: NdjsonEvent): string {
+    const e = event as Record<string, unknown>;
+    return (e.content as string) || (e.text as string) || '';
+  },
+
+  extractSessionIdFromExit(workspaceDir: string): string | null {
+    try {
+      const cacheFile = join(homedir(), '.gemini/antigravity-cli/cache/last_conversations.json');
+      const data = JSON.parse(readFileSync(cacheFile, 'utf8')) as Record<string, string>;
+      return data[workspaceDir] || null;
+    } catch {
+      return null;
+    }
+  },
+};
diff --git a/src/providers/base.ts b/src/providers/base.ts
index 21a521e..38ab33f 100644
